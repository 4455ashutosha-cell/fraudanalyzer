{
  "manifest_version": 3,
  "name": "WebGuard AI - SIH Final 100% Working",
  "version": "3.0.0",
  "description": "8-Engine: Risk, AI Job Fraud, Dark Pattern, Review, Privacy, Adult Blur, Betting, Payment Fraud - 100% Offline, No IP Log, Incognito Ready, Bugs Fixed",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "incognito": "spanning"
}